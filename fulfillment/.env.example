# Copy to .env. Never commit actual credentials.
# Copy the PostgreSQL connection string from Supabase Connect into your local .env.
# Use the direct connection or session pooler; TLS certificates are verified.
DATABASE_URL=
PORT=3100
HOST=127.0.0.1
DATA_DIR=./data
# Public HTTPS origin in production; local development uses http://localhost:5173.
APP_ORIGIN=http://localhost:5173
# Set true behind HTTPS. Leave false only for local HTTP development.
COOKIE_SECURE=false
# OAuth web application credentials from your own Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3100/api/integrations/drive/callback
