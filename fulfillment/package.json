{
  "name": "fulfill-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "create-admin": "node --env-file-if-exists=.env server/create-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python tests/browser.py",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.mjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
