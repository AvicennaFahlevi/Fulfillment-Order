/**
 * LOGO MEIRISTA
 * -------------------------------------------------
 * Logo aplikasi disimpan di file ini, bukan di Index.html.
 * Jangan edit isi base64 secara manual.
 * Pakai di HTML/Apps Script dengan: getBrandLogoDataUri_()
 */

const MEIRISTA_LOGO_BASE64_PARTS_ = [
  '',
];

function getBrandLogoDataUri_() {
  return 'data:image/jpeg;base64,' + MEIRISTA_LOGO_BASE64_PARTS_.join('');
}

/**
 * BACKGROUND MEIRISTA
 * -------------------------------------------------
 * Foto latar (bunga sakura + kosmetik) disimpan di file ini.
 * Jangan edit isi base64 secara manual.
 * Pakai di HTML/Apps Script dengan: getBackgroundDataUri_()
 */

const MEIRISTA_BG_BASE64_PARTS_ = [
  '',
];

function getBackgroundDataUri_() {
  return 'data:image/jpeg;base64,' + MEIRISTA_BG_BASE64_PARTS_.join('');
}